# Local inference is the safe default.
MODEL_PROVIDER=ollama
MODEL_NAME=qwen2:7b-instruct
OLLAMA_BASE_URL=http://localhost:11434/v1

# Cloud inference is opt-in. Never place a real key in this file.
CLOUD_MODEL_ENABLED=false
CLOUD_MODEL_PROVIDER=
CLOUD_MODEL_NAME=
CLOUD_MODEL_API_KEY=

# Bounded execution protects teaching demonstrations from runaway loops.
MAX_AGENT_TURNS=8
MODEL_TIMEOUT_SECONDS=60
MAX_OUTPUT_CHARACTERS=20000
LOG_LEVEL=INFO
